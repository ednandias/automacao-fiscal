{
  "name": "automacao-fiscal",
  "version": "1.0.0",
  "description": "Emite notas fiscais de devolução no ZipHub a partir de planilhas e grava o resultado nelas.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "gen-sheets": "tsx src/scripts/genSheets.ts",
    "typecheck": "tsc",
    "lint": "eslint src"
  },
  "dependencies": {
    "@clack/prompts": "1.5.0",
    "axios": "1.17.0",
    "chalk": "5.6.2",
    "humanize-duration": "3.33.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/humanize-duration": "3.27.4",
    "@types/node": "25.9.1",
    "eslint": "10.4.1",
    "globals": "17.6.0",
    "jiti": "2.7.0",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1"
  }
}
